# =============================================================================
# JobHunterX settings
# =============================================================================
# How to use this file:
#   1. Copy it and name the copy ".env" (in this same folder).
#   2. Paste your keys after the "=" sign. No quotes, no spaces.
#   3. Save, then start the app.
#
# You can also skip this file: start the app and it will ask for the keys on
# the first screen, then save them here for you.
#
# Keys stay on your computer. Never share this file or upload it to GitHub
# (".env" is already in .gitignore).
# =============================================================================


# --- AI keys (all free — and you can even start with NONE) ------------------
# The AI reads your resume and every job.
# No key? The app can use Kilo Gateway's free models (no sign-up, no key).
#   They allow 200 requests per hour per model. Note: these free models may use
#   your prompts (resume text, job posts) to train. Add any key below to avoid that.
# One key is enough. Two or three make searches much faster, because each free
# plan allows only a few calls per minute.

# Google AI Studio — best one to start with. Free, no card needed.
# Get it: https://aistudio.google.com/apikey  →  "Create API key"  →  copy
GOOGLE_API_KEY=

# NVIDIA NIM — free key, 40 requests per minute (fast small models: Nemotron Nano,
# GPT-OSS 20B, GLM Flash, DeepSeek Flash).
# Get it: https://build.nvidia.com/settings/api-keys  →  "Generate API Key"  →  copy
NVIDIA_API_KEY=

# Groq — very fast free models. Good second key.
# Get it: https://console.groq.com/keys  →  "Create API Key"  →  copy (shown once)
GROQ_API_KEY=

# Mistral — free backup when the others are busy (free "Experiment" plan).
# Get it: https://console.mistral.ai/api-keys  →  "Create new key"  →  copy
MISTRAL_API_KEY=

# Kilo Gateway — OPTIONAL. Free models work with no key at all.
# Only set this if you have a Kilo account and want to use it.
KILO_API_KEY=


# --- Web search keys (optional) ----------------------------------------------
# Used to discover job posts on the web. Without any of these, the app uses its
# free Deep Search (no key): it asks 6 free search engines at once, opens
# careers pages to find the real postings, and lets the AI rank the results.
# Every search result is checked before it is shown as a job.

# Tavily — free monthly credits.   Get it: https://app.tavily.com
TAVILY_API_KEY=
# Exa — free credits.              Get it: https://dashboard.exa.ai/api-keys
EXA_API_KEY=
# Brave Search — free monthly use. Get it: https://api-dashboard.search.brave.com/app/keys
BRAVE_API_KEY=
BRAVE_ENABLED=false
# TinyFish — free search utility.
TINYFISH_API_KEY=

ENABLE_WEB_SEARCH_APIS=true
# Which search to try first: tinyfish | tavily | exa | brave | deep | ddgs
PRIMARY_SEARCH_PROVIDER=tinyfish
# true = never use a paid search call, even if a key allows it
STRICT_ZERO_SPEND_PROTECTION=true


# --- Company watchlist --------------------------------------------------------
# While the app is open, it checks the job pages of researched companies in your
# cities (Hyderabad, Bengaluru) every few hours, so you can apply early.
# 0 = turn it off.
WATCH_INTERVAL_HOURS=4


# --- Search size (optional) ---------------------------------------------------
# How many jobs one search looks at, and how many get a full AI read.
# Bigger numbers = slower searches and more AI calls.
MAX_JOBS_PER_SEARCH=60
MAX_LLM_JD_EXTRACTIONS_PER_SEARCH=40
# Seconds to wait for a job page to load.
FETCH_TIMEOUT_S=12
# Advanced: change matching rules (see jobhunterx/intelligence/policy.py), e.g.
# MATCH_POLICY_JSON={"experience_fail_gap_years": 2.5}
MATCH_POLICY_JSON=


# --- Auto-apply (the browser agent) -------------------------------------------
# Auto-apply uses Google Chrome. Install Chrome if you don't have it.
# The browser is shown live inside the app. true = also open a real Chrome window.
BROWSER_SHOW_WINDOW=false
# Most steps the agent takes before handing back to you.
BROWSER_MAX_STEPS=40
# Seconds between steps (keeps free AI plans within their limits).
BROWSER_STEP_DELAY_S=3
# Also prepare and attach these when applying (your resume is always attached).
APPLY_WITH_COVER_LETTER=true
APPLY_WITH_CV=true


# --- App ----------------------------------------------------------------------
# Open http://127.0.0.1:8000 after starting. Change PORT if 8000 is busy.
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO


# --- Where data is saved (inside this folder) ---------------------------------
DB_PATH=./data/jobhunterx.db
CACHE_DIR=./data/cache
SCREENSHOTS_DIR=./data/screenshots


# --- Advanced: AI models (optional) -------------------------------------------
# Gemma model on the Gemini API (default gemma-4-31b-it)
# GEMMA_MODEL=gemma-4-31b-it
# Change free-plan limits per model if your account is different, e.g.:
# MODEL_LIMITS_JSON={"gemini/gemma-4-31b-it": {"rpm": 30, "rpd": 14400}}
