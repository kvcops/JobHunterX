# === LLM providers (model chains are defined in jobhunterx/config/llm_router.py) ===
GOOGLE_API_KEY=your_gemini_api_key
GROQ_API_KEY=your_groq_api_key
MISTRAL_API_KEY=your_mistral_api_key

# === Web search providers (leads only — every result is verified before it becomes a job) ===
ENABLE_WEB_SEARCH_APIS=true
PRIMARY_SEARCH_PROVIDER=tinyfish        # tinyfish | tavily | exa | brave | ddgs
STRICT_ZERO_SPEND_PROTECTION=true
TINYFISH_API_KEY=
TAVILY_API_KEY=
EXA_API_KEY=
BRAVE_API_KEY=
BRAVE_ENABLED=false

# === Discovery & matching tuning (optional) ===
MAX_JOBS_PER_SEARCH=60
MAX_LLM_JD_EXTRACTIONS_PER_SEARCH=40
FETCH_TIMEOUT_S=12
# Override matching policy values from jobhunterx/intelligence/policy.py, e.g.
# MATCH_POLICY_JSON={"experience_fail_gap_years": 2.5, "weights": {"skills_required": 0.3}}
MATCH_POLICY_JSON=

# === Application ===
BROWSER_USE_HEADLESS=false
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# === Storage ===
DB_PATH=./data/jobhunterx.db
CACHE_DIR=./data/cache
SCREENSHOTS_DIR=./data/screenshots
