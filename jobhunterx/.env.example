# === LLM Providers ===
GOOGLE_API_KEY=your_gemini_api_key
GROQ_API_KEY=your_groq_api_key
MISTRAL_API_KEY=your_mistral_api_key

# === Web Search API Providers & Router Settings ===
ENABLE_WEB_SEARCH_APIS=true
SEARCH_ROUTER_MODE=sequential
PRIMARY_SEARCH_PROVIDER=tinyfish
STRICT_ZERO_SPEND_PROTECTION=true
QUALITY_SCORE_THRESHOLD=0.60

TINYFISH_API_KEY=your_tinyfish_api_key
TAVILY_API_KEY=your_tavily_api_key
EXA_API_KEY=your_exa_api_key
BRAVE_API_KEY=your_brave_api_key
BRAVE_ENABLED=false

# === Application Settings ===
BROWSER_USE_HEADLESS=false
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# === Storage ===
DB_PATH=./data/jobhunterx.db
CACHE_DIR=./data/cache
SCREENSHOTS_DIR=./data/screenshots
