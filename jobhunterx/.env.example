# === LLM providers (model chains are defined in jobhunterx/config/llm_router.py) ===
GOOGLE_API_KEY=your_gemini_api_key
GROQ_API_KEY=your_groq_api_key
MISTRAL_API_KEY=your_mistral_api_key

# === Web search providers (leads only — every result is verified before it becomes a job) ===
ENABLE_WEB_SEARCH_APIS=true
PRIMARY_SEARCH_PROVIDER=tinyfish        # tinyfish | tavily | exa | brave | ddgs
STRICT_ZERO_SPEND_PROTECTION=true
TINYFISH_API_KEY=
TAVILY_API_KEY=
EXA_API_KEY=
BRAVE_API_KEY=
BRAVE_ENABLED=false

# === Discovery & matching tuning (optional) ===
MAX_JOBS_PER_SEARCH=60
MAX_LLM_JD_EXTRACTIONS_PER_SEARCH=40
FETCH_TIMEOUT_S=12
# Override matching policy values from jobhunterx/intelligence/policy.py, e.g.
# MATCH_POLICY_JSON={"experience_fail_gap_years": 2.5, "weights": {"skills_required": 0.3}}
MATCH_POLICY_JSON=

# === Auto-apply (browser agent) ===
# The browser is shown live inside the app (Auto-apply tab). Set to true only to ALSO open a real window (debugging).
BROWSER_SHOW_WINDOW=false
BROWSER_MAX_STEPS=40
BROWSER_STEP_DELAY_S=3
# Documents checked (and written if missing) before the agent starts. The resume is always attached.
APPLY_WITH_COVER_LETTER=true
APPLY_WITH_CV=true

# === Application ===
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# === Storage ===
DB_PATH=./data/jobhunterx.db
CACHE_DIR=./data/cache
SCREENSHOTS_DIR=./data/screenshots

# --- Models (optional) ---
# Gemma model on the Gemini API (default gemma-4-31b-it)
# GEMMA_MODEL=gemma-4-31b-it
# Override free-tier limits per model if your account differs, e.g.:
# MODEL_LIMITS_JSON={"gemini/gemma-4-31b-it": {"rpm": 30, "rpd": 14400}, "groq/openai/gpt-oss-120b": {"tpm": 8000}}
