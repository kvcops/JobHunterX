# =============================================================================
# JobHunterX settings
# =============================================================================
# How to use this file:
#   1. Copy it and name the copy ".env" (in this same folder).
#   2. Paste your keys after the "=" sign. No quotes, no spaces.
#   3. Save, then start the app.
#
# You can also skip this file: start the app and it will ask for the keys on
# the first screen, then save them here for you.
#
# Keys stay on your computer. Never share this file or upload it to GitHub
# (".env" is already in .gitignore).
# =============================================================================


# --- AI keys (all free — and you can even start with NONE) ------------------
# The AI reads your resume and every job.
# No key? The app can use Kilo Gateway's free models (no sign-up, no key).
#   They allow 200 requests per hour per model. Note: these free models may use
#   your prompts (resume text, job posts) to train. Add any key below to avoid that.
# One key is enough. Two or three make searches much faster, because each free
# plan allows only a few calls per minute.

# Google AI Studio — best one to start with. Free, no card needed.
# Get it: https://aistudio.google.com/apikey  →  "Create API key"  →  copy
GOOGLE_API_KEY=

# NVIDIA NIM — free key, 40 requests per minute (fast small models: Nemotron Nano,
# GPT-OSS 20B, GLM Flash, DeepSeek Flash).
# Get it: https://build.nvidia.com/settings/api-keys  →  "Generate API Key"  →  copy
NVIDIA_API_KEY=

# Groq — very fast free models. Good second key.
# Get it: https://console.groq.com/keys  →  "Create API Key"  →  copy (shown once)
GROQ_API_KEY=

# Mistral — free backup when the others are busy (free "Experiment" plan).
# Get it: https://console.mistral.ai/api-keys  →  "Create new key"  →  copy
MISTRAL_API_KEY=

# Kilo Gateway — OPTIONAL. Free models work with no key at all.
# Only set this if you have a Kilo account and want to use it.
KILO_API_KEY=


# --- Web search keys (optional) ----------------------------------------------
# Used to discover job posts on the web. Without any of these, the app uses its
# free Deep Search (no key): it asks 6 free search engines at once, opens
# careers pages to find the real postings, and lets the AI rank the results.
# Every search result is checked before it is shown as a job.

# Tavily — free monthly credits.   Get it: https://app.tavily.com
TAVILY_API_KEY=
# Exa — free credits.              Get it: https://dashboard.exa.ai/api-keys
EXA_API_KEY=
# Brave Search — free monthly use. Get it: https://api-dashboard.search.brave.com/app/keys
BRAVE_API_KEY=
BRAVE_ENABLED=false
# TinyFish — free search utility.
TINYFISH_API_KEY=

ENABLE_WEB_SEARCH_APIS=true
# Which search to try first: tinyfish | tavily | exa | brave | deep | ddgs
PRIMARY_SEARCH_PROVIDER=tinyfish
# true = never use a paid search call, even if a key allows it
STRICT_ZERO_SPEND_PROTECTION=true


# --- Company watchlist --------------------------------------------------------
# While the app is open, it checks the job pages of researched companies in your
# cities (Hyderabad, Bengaluru) every few hours, so you can apply early.
# 0 = turn it off.
WATCH_INTERVAL_HOURS=4


# --- Search size (optional) ---------------------------------------------------
# How many jobs one search looks at, and how many get a full AI read.
# Bigger numbers = slower searches and more AI calls.
MAX_JOBS_PER_SEARCH=60
MAX_LLM_JD_EXTRACTIONS_PER_SEARCH=40
# LinkedIn's public job feed (no login): newest posts, matched to the employer's own job board when possible.
ENABLE_LINKEDIN_SOURCE=true
# Skip LinkedIn posts that already show this many applicants (that crowd rarely gets read).
LINKEDIN_MAX_APPLICANTS=150
# Seconds to wait for a job page to load.
FETCH_TIMEOUT_S=12
# Advanced: change matching rules (see jobhunterx/intelligence/policy.py), e.g.
# MATCH_POLICY_JSON={"experience_fail_gap_years": 2.5}
MATCH_POLICY_JSON=


# --- Auto-apply (the browser agent) -------------------------------------------
# Auto-apply uses Google Chrome. Install Chrome if you don't have it.
# The browser is shown live inside the app. true = also open a real Chrome window.
BROWSER_SHOW_WINDOW=false
# Most steps the agent takes before handing back to you.
BROWSER_MAX_STEPS=40
# Seconds between steps (busy free AI plans are retried automatically).
BROWSER_STEP_DELAY_S=1
# How the browser runs. auto = your real Chrome, headless: no window opens, you watch it in the app.
# Other values: headless | offscreen (a real window parked off-screen) | window (visible, for debugging)
BROWSER_WINDOW_MODE=auto
# Optional: drive a Chrome you started yourself — your home internet, your logins, almost no CAPTCHAs:
#   chrome --remote-debugging-port=9222 --user-data-dir=C:\jhx-chrome
# then BROWSER_CDP_URL=http://127.0.0.1:9222
# Or a hosted stealth browser's CDP address (Browserbase, Steel, Browser Use cloud…) when running on a server.
BROWSER_CDP_URL=
# Optional: path to Chrome / Edge if it is installed somewhere unusual.
# BROWSER_EXECUTABLE_PATH=
# Also prepare and attach these when applying (your resume is always attached).
APPLY_WITH_COVER_LETTER=true
APPLY_WITH_CV=true


# --- App ----------------------------------------------------------------------
# Open http://127.0.0.1:9000 after starting. Change PORT if 9000 is busy.
# On a server use HOST=0.0.0.0 (hosts like Render set PORT themselves).
HOST=127.0.0.1
PORT=9000
LOG_LEVEL=INFO


# --- Production mode: login, users, each user's own data ----------------------
# Leave APP_ENV empty (or delete it) for the normal local app: no login page at all.
# APP_ENV=prod turns on:
#   * a login page — nothing else (pages, API, live updates, API docs) opens without signing in
#   * the admin below, who adds other users on the "Users" page
#   * each user sees only their own profiles, jobs and documents
#   * users bring their own AI keys (saved encrypted); the free shared models (Kilo, LLM7) stay with the admin,
#     because their limits count per server address
#   * no Swagger / ReDoc / OpenAPI pages
APP_ENV=
# Required when APP_ENV=prod. The admin is created (or its password updated) from these on every start.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Encrypts the users' saved API keys. Use a long random text and keep it the same (changing it means users paste
# their keys again). Empty = a random one is made and kept in data/.secret_key.
SECRET_KEY=
# How long a login lasts (hours).
SESSION_HOURS=12
# Login cookie: SameSite strict|lax|none (none only if the UI runs on another site), Secure auto|true|false.
COOKIE_SAMESITE=strict
COOKIE_SECURE=auto
# CORS — empty = only this app's own address may call the API (the usual setup: the app serves its own pages).
# Comma separated, e.g. CORS_ORIGINS=https://jobs.example.com,https://www.example.com
CORS_ORIGINS=
# Empty = GET,POST,PUT,PATCH,DELETE and Content-Type. Credentials: empty = on when CORS_ORIGINS is set in prod.
CORS_METHODS=
CORS_HEADERS=
CORS_ALLOW_CREDENTIALS=
# Proxies trusted for X-Forwarded-For / -Proto (real visitor address, https). Empty = * in prod, 127.0.0.1 otherwise.
FORWARDED_ALLOW_IPS=


# --- Agents office ----------------------------------------------------------------
# The 3D office in Discover. true = break-time chats written by AI in batches and "ask an agent" answered by AI.
# false = built-in lines and plain summaries, no AI calls at all. (Also a switch in Settings → Agents office.)
OFFICE_AI_ENABLED=true


# --- Capacity (optional) ----------------------------------------------------------
# Worked out automatically from the free memory and CPUs (inside a container: its own limits, not the host's).
# Searches over the limit wait in a queue. Set a number only to pin a value.
# MAX_PARALLEL_SEARCHES=
# FETCH_CONCURRENCY=
# BOARD_CONCURRENCY=
# QUERY_CONCURRENCY=
# THREAD_POOL_SIZE=


# --- Where data is saved (inside this folder) ---------------------------------
DB_PATH=./data/jobhunterx.db
CACHE_DIR=./data/cache
SCREENSHOTS_DIR=./data/screenshots


# --- Advanced: AI models (optional) -------------------------------------------
# Gemma model on the Gemini API (default gemma-4-31b-it)
# GEMMA_MODEL=gemma-4-31b-it
# Change free-plan limits per model if your account is different, e.g.:
# MODEL_LIMITS_JSON={"gemini/gemma-4-31b-it": {"rpm": 30, "rpd": 14400}}
