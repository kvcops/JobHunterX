@page { size: A4; margin: {{ margin_y }} {{ margin_x }}; }
body { font-family: Helvetica, Arial, sans-serif; font-size: {{ font_size_body }}; color: #1f2937; line-height: {{ line_height }}; }
.name { font-size: {{ font_size_name }}; font-weight: bold; color: #111827; }
.headline { font-size: {{ font_size_section }}; color: #374151; }
.contact { font-size: {{ font_size_small }}; color: #4b5563; }
.contact a, a { color: #1d4ed8; text-decoration: none; }
.contact a { white-space: nowrap; }   /* a long address moves to the next line whole, never split mid-URL */
.section { margin-top: {{ margin_section }}; }
.section-title { font-size: {{ font_size_section }}; font-weight: bold; text-transform: uppercase; letter-spacing: 0.5px;
  color: #111827; border-bottom: 1px solid #111827; padding-bottom: 1px; margin-bottom: 3px; }
.row-title { font-weight: bold; color: #111827; }
.row-sub { color: #4b5563; font-size: {{ font_size_small }}; }
.right { text-align: right; color: #4b5563; font-size: {{ font_size_small }}; }
ul { margin: 1px 0 {{ margin_exp }} 0; padding-left: 12px; }
li { margin-bottom: {{ margin_bullet }}; font-size: {{ font_size_bullet }}; }
.skills td { padding: 0 0 1px 0; vertical-align: top; font-size: {{ font_size_skill }}; }
.skill-cat { font-weight: bold; width: 26%; }
table { width: 100%; }
.links { width: 32%; }
