{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JobHunterX",
  "version": "2.0.0",
  "identifier": "com.kvcops.jobhunterx",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "AI job search assistant that runs on your computer",
    "longDescription": "JobHunterX finds verified jobs that fit your resume, explains every score, writes honest tailored documents and helps you apply. Everything runs on your computer; your data stays in your own app folder.",
    "copyright": "JobHunterX contributors",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "backend/": "backend/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc1MkJBNEQyMkExQjlFM0EKUldRNm5oc3EwcVFyZFJFNTJxWkZ1OGx6QTFSWjZUWHF4QTZEMUhwMk1QRm1SaVpTaW9KQ21xVEcK",
      "endpoints": [
        "https://github.com/kvcops/JobHunterX/releases/latest/download/latest.json"
      ]
    }
  }
}
